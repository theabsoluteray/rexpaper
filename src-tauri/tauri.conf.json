{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RexPaper",
  "version": "1.0.3",
  "identifier": "com.rexpaper.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "RexPaper",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "maximized": true,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
