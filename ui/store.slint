export struct WallpaperData {
    path: string,
    category: string,
}

export global AppStore {
    in-out property <string> wallpaper-dir: "No folder selected";

    in-out property <[WallpaperData]> static-wallpapers: [];
    in-out property <[WallpaperData]> live-wallpapers: [];

    in-out property <[string]> categories: ["Root"];

    in-out property <string> active-category: "Root";

    callback select-wallpaper-dir();
}

export global Theme {
    in-out property <bool> dark: true;

    in-out property <color> bg: root.dark ? #000000 : #ffffff;
    in-out property <color> sidebar: root.dark ? #0a0a0a : #f2f2f2;
    in-out property <color> card: root.dark ? #141414 : #ffffff;
    in-out property <color> card-hover: root.dark ? #1e1e1e : #f2f2f2;
    in-out property <color> sunken: root.dark ? #0a0a0a : #e5e5e5;

    in-out property <color> text: root.dark ? #ffffff : #000000;
    in-out property <color> text-secondary: root.dark ? #bbbbbb : #333333;
    in-out property <color> text-muted: root.dark ? #888888 : #777777;

    in-out property <color> accent: root.dark ? #ffffff : #000000;
    in-out property <color> accent-soft: root.dark ? #ffffff22 : #00000022;

    in-out property <color> border: root.dark ? #2a2a2a : #cccccc;
    in-out property <color> divider: root.dark ? #1e1e1e : #d9d9d9;

    in-out property <color> hover: root.dark ? #1e1e1e : #e8e8e8;
    in-out property <color> pressed: root.dark ? #2a2a2a : #d0d0d0;

    in-out property <color> nav-active: root.dark ? #ffffff22 : #00000018;
    in-out property <color> nav-active-accent: root.dark ? #ffffff : #000000;
}
