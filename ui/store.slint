export struct WallpaperData {
    name: string,
    thumb: image,
    category: string,
    is-live: bool,
    path: string,
}

export struct RowData {
    items: [WallpaperData],
}

export global AppStore {
    in-out property <string> wallpaper-dir: "No folder selected";
    in-out property <string> live-wallpaper-dir: "No folder selected";

    in-out property <[WallpaperData]> static-wallpapers: [];
    in-out property <[WallpaperData]> live-wallpapers: [];

    in-out property <[WallpaperData]> filtered-static-wallpapers: [];
    in-out property <[WallpaperData]> filtered-live-wallpapers: [];

    in-out property <[RowData]> static-rows: [];
    in-out property <[RowData]> live-rows: [];

    in-out property <int> grid-columns: 4;

    in-out property <[string]> categories: ["All"];
    in-out property <[string]> live-categories: ["All"];

    in-out property <string> active-category: "All";
    in-out property <string> active-live-category: "All";

    in-out property <string> static-search-query: "";
    in-out property <string> live-search-query: "";

    in-out property <bool> run-on-startup: false;
    in-out property <bool> pause-on-fullscreen: true;
    in-out property <bool> mute-live-wallpapers: true;
    in-out property <bool> live-wallpaper-active: false;

    in-out property <bool> live-preview-visible: false;
    in-out property <string> live-preview-path: "";
    in-out property <image> live-preview-frame;

    callback select-wallpaper-dir();
    callback select-live-wallpaper-dir();
    callback set-active-category(string);
    callback set-active-live-category(string);
    callback filter-static-search(string);
    callback filter-live-search(string);
    callback play-live-wallpaper(string);
    callback stop-live-wallpaper();
    callback apply-live-wallpaper(string);
    callback stop-desktop-live-wallpaper();
    callback apply-static-wallpaper(string);
    callback toggle-startup(bool);
    callback toggle-pause-fullscreen(bool);
    callback toggle-mute-live(bool);
}

export global Theme {
    in-out property <bool> dark: true;

    in-out property <color> bg: root.dark ? #0d0f17 : #f4f5f8;
    in-out property <color> sidebar: root.dark ? #121520 : #ffffff;
    in-out property <color> card: root.dark ? #181c28 : #ffffff;
    in-out property <color> card-hover: root.dark ? #22283a : #f1f3f7;
    in-out property <color> sunken: root.dark ? #0f121a : #e8ebf0;

    in-out property <color> text: root.dark ? #ffffff : #0f172a;
    in-out property <color> text-secondary: root.dark ? #a0a6b8 : #525c6e;
    in-out property <color> text-muted: root.dark ? #6d758a : #8b95a8;

    in-out property <color> accent: root.dark ? #ffffff : #0f172a;
    in-out property <color> accent-primary: #6366f1;
    in-out property <color> accent-soft: root.dark ? #6366f12e : #6366f11c;

    in-out property <color> border: root.dark ? #262c3e : #d8dce6;
    in-out property <color> border-subtle: root.dark ? #1e2332 : #e5e8f0;
    in-out property <color> divider: root.dark ? #1c212f : #e5e8f0;

    in-out property <color> hover: root.dark ? #202637 : #e8ecf4;
    in-out property <color> pressed: root.dark ? #2a3248 : #dce1ed;

    in-out property <color> nav-active: root.dark ? #ffffff1c : #0f172a14;
    in-out property <color> nav-active-accent: root.dark ? #ffffff : #0f172a;
}