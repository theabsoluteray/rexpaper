import { Theme } from "store.slint";

component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <bool> active;
    callback clicked();

    height: 36px;
    border-radius: 6px;
    border-width: 1px;
    border-color: active ? Theme.accent : transparent;

    background: active ? Theme.nav-active : transparent;
    animate background { duration: 0.12s; }
    animate border-color { duration: 0.12s; }

    if has-icon : Image {
        x: 12px;
        y: (parent.height - self.height) / 2;
        source: icon;
        width: 18px;
        height: 18px;
        colorize: active ? Theme.accent : Theme.text-secondary;
    }

    Text {
        x: has-icon ? 36px : 16px;
        text: label;
        color: active ? Theme.text : Theme.text-secondary;
        vertical-alignment: center;
        horizontal-alignment: left;
        font-size: 15px;
        font-weight: active ? 700 : 600;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    states [
        hover when touch.has-hover && !active: {
            background: Theme.hover;
            border-color: Theme.border;
        }
    ]
}

export component NavBar inherits Rectangle {
    background: Theme.sidebar;
    width: 220px;

    in property <string> active-page;
    callback page-selected(string);

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: Theme.border;
    }

    VerticalLayout {
        padding-top: 0px;
        padding-bottom: 12px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 2px;

        VerticalLayout {
            padding-top: 10px;
            padding-left: 4px;
            padding-bottom: 20px;

            Text {
                text: "RexPaper";
                font-family: "jim nightshade";  
                font-size: 25px;
                font-weight: 700;
                color: Theme.text;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            padding-bottom: 8px;

            Rectangle {
                height: 1px;
                horizontal-stretch: 1;
                background: Theme.divider;
            }
        }

        NavItem {
            icon: @image-url("../assets/static.png");
            label: "Static";
            active: root.active-page == "static";
            clicked => { root.page-selected("static"); }
        }

        NavItem {
            icon: @image-url("../assets/live.png");
            label: "Live";
            active: root.active-page == "live";
            clicked => { root.page-selected("live"); }
        }

        Rectangle { vertical-stretch: 1; }

        VerticalLayout {
            padding-bottom: 8px;

            Rectangle {
                height: 1px;
                horizontal-stretch: 1;
                background: Theme.divider;
            }
        }

        NavItem {
            icon: @image-url("../assets/settings.png");
            label: "Settings";
            active: root.active-page == "settings";
            clicked => { root.page-selected("settings"); }
        }
    }
}
