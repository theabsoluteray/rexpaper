import { Theme } from "store.slint";

component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <bool> active;
    callback clicked();

    height: 42px;
    border-radius: 8px;
    border-width: 1px;
    border-color: active ? Theme.border : transparent;

    background: active ? Theme.nav-active : transparent;
    animate background { duration: 180ms; easing: ease-out; }
    animate border-color { duration: 180ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        if has-icon : Image {
            source: icon;
            width: 18px;
            height: 18px;
            image-fit: contain;
            y: (parent.height - self.height) / 2;
            colorize: active ? Theme.text : (touch.has-hover ? Theme.text : Theme.text-secondary);
            animate colorize { duration: 180ms; easing: ease-out; }
        }

        Text {
            text: label;
            color: active ? Theme.text : (touch.has-hover ? Theme.text : Theme.text-secondary);
            vertical-alignment: center;
            horizontal-alignment: left;
            font-size: 14px;
            font-weight: active ? 700 : 500;
            animate color { duration: 180ms; easing: ease-out; }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    states [
        pressed when touch.pressed: {
            background: Theme.pressed;
        }
        hover when touch.has-hover && !active: {
            background: Theme.hover;
            border-color: Theme.border;
        }
    ]
}

export component NavBar inherits Rectangle {
    background: Theme.sidebar;
    width: 230px;

    in property <string> active-page;
    callback page-selected(string);

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: Theme.border;
    }

    VerticalLayout {
        padding-top: 20px;
        padding-bottom: 20px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 6px;

      
            VerticalLayout {
                spacing: 1px;
                alignment: center;

                Text {
                    text: "RexPaper";
                    font-size: 18px;
                    font-weight: 800;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Text {
                    text: "Wallpaper Manager";
                    font-size: 10px;
                    font-weight: 500;
                    color: Theme.text-muted;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.divider;
            vertical-stretch: 0;
        }

        Rectangle { height: 10px; vertical-stretch: 0; }

        HorizontalLayout {
            padding-left: 10px;
            padding-bottom: 4px;
            vertical-stretch: 0;

            Text {
                text: "WALLPAPERS";
                font-size: 10px;
                font-weight: 700;
                color: Theme.text-muted;
            }
        }

        NavItem {
            icon: @image-url("../assets/static.svg");
            label: "Static";
            active: root.active-page == "static";
            clicked => { root.page-selected("static"); }
            vertical-stretch: 0;
        }

        NavItem {
            icon: @image-url("../assets/live.svg");
            label: "Live";
            active: root.active-page == "live";
            clicked => { root.page-selected("live"); }
            vertical-stretch: 0;
        }

        // Pushes settings to bottom
        Rectangle { vertical-stretch: 1; }

        Rectangle {
            height: 1px;
            background: Theme.divider;
            vertical-stretch: 0;
        }

        Rectangle { height: 6px; vertical-stretch: 0; }

        NavItem {
            icon: @image-url("../assets/settings.svg");
            label: "Settings";
            active: root.active-page == "settings";
            clicked => { root.page-selected("settings"); }
            vertical-stretch: 0;
        }
    }
}
