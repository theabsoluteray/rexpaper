import { Theme } from "store.slint";

export component StaticPage inherits Rectangle {
    background: Theme.bg;

    VerticalLayout {
        padding: 36px;
        padding-top: 28px;
        spacing: 20px;

        Text {
            text: "Static Wallpapers";
            font-size: 24px;
            font-weight: 700;
            color: Theme.text;
        }

        Text {
            text: "Your static wallpaper collection";
            font-size: 13px;
            color: Theme.text-secondary;
        }

        Rectangle {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            background: Theme.card;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: "No wallpapers yet";
                    font-size: 15px;
                    font-weight: 500;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Add a folder in Settings to get started";
                    font-size: 12px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
