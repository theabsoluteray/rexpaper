import { VerticalBox } from "std-widgets.slint";
import { VerticalBox, HorizontalBox, Switch, ComboBox, GroupBox, LineEdit, Button } from "std-widgets.slint";
import {AppStore} from "store.slint";

export component SettingsPage inherits Rectangle {
    background: #0d1117; // Match main window dark background

    // --- Properties sent FROM Rust to Slint (to populate saved settings) ---
    in property <bool> run-on-startup: false;
    in property <bool> pause-on-fullscreen: true;
    in property <string> wallpaper-dir: "/home/user/wallpapers";

    // --- Callbacks sent FROM Slint TO Rust (when user changes something) ---
    callback toggle-startup(bool);
    callback toggle-pause-fullscreen(bool);
    callback select-wallpaper-dir();

    VerticalBox {
        padding: 40px; // More generous padding for content breathing room
        spacing: 28px; // Increased gap between sections
        alignment: start;

        // Page title — large and prominent
        VerticalLayout {
            spacing: 6px;
            padding-bottom: 4px; // Small gap below title block

            Text {
                text: "Settings";
                font-size: 28px;
                font-weight: 800;
                color: #e6edf3; // Primary light text
            }

            // Accent underline — adds a color accent below the title
            Rectangle {
                height: 3px;
                width: 48px; // Short accent bar, not full width
                background: #1f6feb; // Matches nav active accent
                border-radius: 2px;
            }
        }

        // --- SECTION 1: App & System Settings ---
        GroupBox {
            title: "General Behavior";

            VerticalBox {
                spacing: 14px; // More space between toggle rows

                Switch {
                    text: "Run on System Startup";
                    checked: root.run-on-startup;
                    toggled => {
                        root.toggle-startup(self.checked);
                    }
                }

                Switch {
                    text: "Pause Live Wallpapers on Fullscreen Games/Apps";
                    checked: root.pause-on-fullscreen;
                    toggled => {
                        root.toggle-pause-fullscreen(self.checked);
                    }
                }
            }
        }

        // --- SECTION 2: Directories ---
        GroupBox {
            title: "Wallpaper Storage";

            VerticalBox {
                spacing: 14px;

                // Helper text explaining what this section does
                Text {
                    text: "Select a directory or add a git repository to download wallpapers from. The app will automatically scan for images.";
                    color: #8b949e; // Muted secondary text
                    wrap: word-wrap;
                    font-size: 13px; // Slightly smaller for helper text
                }

                HorizontalBox {
                    spacing: 10px;

                    // Read-only path display — shows current wallpaper directory
                    LineEdit {
                        text: root.wallpaper-dir;
                        enabled: false;
                    }

                    // Browse button — triggers native file dialog via Rust
                    Button {
                        text: "Browse...";
                        clicked => {
                            AppStore.select-wallpaper-dir();
                        }
                    }
                }
            }
        }
    }
}
