import { AppStore, Theme } from "store.slint";
import { ScrollView } from "std-widgets.slint";

component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);

    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: self.checked ? Theme.accent : (Theme.dark ? #323340 : #d0d0d8);
    animate background { duration: 0.15s; }

    touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
        mouse-cursor: pointer;
    }

    Rectangle {
        x: root.checked ? parent.width - 22px : 2px;
        width: 20px;
        height: 20px;
        y: 2px;
        border-radius: 10px;
        background: root.checked ? (Theme.dark ? #000000 : #ffffff) : (Theme.dark ? #aaaaaa : #ffffff);
        animate x { duration: 0.15s; }
        animate background { duration: 0.15s; }
    }

    states [
        hover when touch.has-hover: {
            background: root.checked
                ? (Theme.dark ? #f0f0f5 : #1a1a1a)
                : (Theme.dark ? #424354 : #c0c0c8);
        }
    ]
}

export component SettingsPage inherits Rectangle {
    background: Theme.bg;

    in property <bool> run-on-startup: AppStore.run-on-startup;
    in property <bool> pause-on-fullscreen: AppStore.pause-on-fullscreen;
    in property <bool> mute-live-wallpapers: AppStore.mute-live-wallpapers;

    VerticalLayout {
        padding: 24px;
        padding-top: 20px;
        padding-bottom: 20px;
        spacing: 16px;

        // Header - fixed
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 3px;

            Text {
                text: "Settings";
                font-size: 24px;
                font-weight: 800;
                color: Theme.text;
            }

            Text {
                text: "Configure application behavior, appearance, and wallpaper storage";
                font-size: 13px;
                color: Theme.text-secondary;
            }
        }

        // Settings Content
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 16px;
                alignment: start;

                // Appearance Card
                Rectangle {
                    background: Theme.card;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 14px;

                        Text {
                            text: "Appearance";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            height: 38px;

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 6px;
                                background: Theme.dark ? Theme.accent : Theme.sunken;
                                border-width: 1px;
                                border-color: Theme.border;
                                animate background { duration: 0.15s; }

                                Text {
                                    text: "Dark Theme";
                                    font-size: 13px;
                                    font-weight: Theme.dark ? 700 : 500;
                                    color: Theme.dark ? #000000 : Theme.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                touch-dark := TouchArea {
                                    clicked => { Theme.dark = true; }
                                    mouse-cursor: pointer;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 6px;
                                background: !Theme.dark ? Theme.accent : Theme.sunken;
                                border-width: 1px;
                                border-color: Theme.border;
                                animate background { duration: 0.15s; }

                                Text {
                                    text: "Light Theme";
                                    font-size: 13px;
                                    font-weight: !Theme.dark ? 700 : 500;
                                    color: !Theme.dark ? #ffffff : Theme.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                touch-light := TouchArea {
                                    clicked => { Theme.dark = false; }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                }

                // General Behavior Card
                Rectangle {
                    background: Theme.card;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;

                        Text {
                            text: "System Behavior";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text;
                        }

                        VerticalLayout {
                            spacing: 14px;

                            HorizontalLayout {
                                spacing: 12px;
                                height: 26px;
                                alignment: start;

                                ToggleSwitch {
                                    checked: root.run-on-startup;
                                    toggled => { AppStore.toggle-startup(self.checked); }
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "Run on system startup";
                                    font-size: 13px;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                height: 26px;
                                alignment: start;

                                ToggleSwitch {
                                    checked: root.pause-on-fullscreen;
                                    toggled => { AppStore.toggle-pause-fullscreen(self.checked); }
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "Pause wallpaper playback when running fullscreen applications";
                                    font-size: 13px;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                height: 26px;
                                alignment: start;

                                ToggleSwitch {
                                    checked: root.mute-live-wallpapers;
                                    toggled => { AppStore.toggle-mute-live(self.checked); }
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "Mute live wallpaper audio by default";
                                    font-size: 13px;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Static Wallpaper Storage Card
                Rectangle {
                    background: Theme.card;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;

                        Text {
                            text: "Static Wallpaper Directory";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text;
                        }

                        Text {
                            text: "Folder to scan for images (.png, .jpg, .webp). Setting this also automatically scans for video wallpapers in the same folder if live directory is not customized.";
                            font-size: 13px;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            height: 38px;

                            Rectangle {
                                background: Theme.sunken;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.border;
                                horizontal-stretch: 1;

                                Text {
                                    text: AppStore.wallpaper-dir;
                                    font-size: 13px;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    x: 12px;
                                }
                            }

                            Rectangle {
                                background: Theme.accent;
                                border-radius: 6px;
                                min-width: 100px;

                                Text {
                                    text: "Browse...";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: Theme.dark ? #000000 : #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => { AppStore.select-wallpaper-dir(); }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                }

                // Live Wallpaper Storage Card
                Rectangle {
                    background: Theme.card;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;

                        Text {
                            text: "Live Wallpaper Directory";
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text;
                        }

                        Text {
                            text: "Folder to scan for videos (.mp4, .webm, .mkv, .mov). Subfolders become category filters.";
                            font-size: 13px;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            height: 38px;

                            Rectangle {
                                background: Theme.sunken;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.border;
                                horizontal-stretch: 1;

                                Text {
                                    text: AppStore.live-wallpaper-dir;
                                    font-size: 13px;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    x: 12px;
                                }
                            }

                            Rectangle {
                                background: Theme.accent;
                                border-radius: 6px;
                                min-width: 100px;

                                Text {
                                    text: "Browse...";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: Theme.dark ? #000000 : #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => { AppStore.select-live-wallpaper-dir(); }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}